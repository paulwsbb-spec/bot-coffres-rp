# Token du bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=
# ID du serveur Discord (clic droit sur le serveur > Copier l'identifiant)
GUILD_ID=

# Dashboard web
DASHBOARD_PORT=3000
# Laisser vide = pas de mot de passe (OK en local uniquement)
DASHBOARD_PASSWORD=
# URL publique affichée par /dashboard
DASHBOARD_URL=http://localhost:3000

# Base de données (SQLite)
DB_PATH=./data/coffres.db
